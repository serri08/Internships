#Mobile tax caluclator
Mobile_price = float(input("enter the mobile price"))
Gst = float(input("enter the gst"))
Discount = float (input("enter the discount"))
Additional_discount =  (input("enter the addition discount"))

Final_price = Mobile_price + Gst - Discount - Additional_discount

